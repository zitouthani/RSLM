# Leave blank to use the local Qdrant database. Docker Compose overrides this.
QDRANT_URL=

# Ollama server; Docker Compose points to the host machine.
OLLAMA_HOST=http://127.0.0.1:11434

# Required to enable authenticated corpus administration and PDF uploads.
# Use a long, random value and enter the same value in the Streamlit sidebar.
RSLM_ADMIN_KEY=

# Base URL used by browsers to open cited PDFs.
PUBLIC_API_BASE_URL=http://localhost:8080

# API base URL used by Streamlit.
RSLM_API_URL=http://127.0.0.1:8080

# Browser origins allowed to call the API. CORS is not authentication.
RSLM_ALLOWED_ORIGINS=http://localhost:5173

# Maximum simultaneous chat generations.
MAX_CONCURRENT_CHAT_REQUESTS=2

# Audit logs contain questions and retrieved source metadata; disabled by default.
AUDIT_LOG_ENABLED=false

# Debug logs can contain questions and excerpts from private documents.
RSLM_DEBUG_CONTENT_LOGS=false

# Optional comma-separated PDF filenames excluded from retrieval.
RAG_EXCLUDED_DOCUMENTS=
RETRIEVAL_LIMIT=10

# Traces may contain conversation text and document passages.
# Enable only when needed; traces are stored locally in logs/xai_trace.jsonl.
XAI_TRACE_ENABLED=false
